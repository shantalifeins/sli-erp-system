const fs = require('fs');
const path = require('path');

function replaceInDir(dir) {
    const files = fs.readdirSync(dir);
    for (const file of files) {
        const fullPath = path.join(dir, file);
        if (fs.statSync(fullPath).isDirectory()) {
            replaceInDir(fullPath);
        } else if (fullPath.endsWith('.tsx') || fullPath.endsWith('.ts')) {
            let content = fs.readFileSync(fullPath, 'utf8');
            let original = content;
            
            // Replace ../components with @/src/shared/components, etc.
            // Also need to handle ../../components if any
            content = content.replace(/from\s+['"]\.\.\/components/g, "from '@/src/shared/components");
            content = content.replace(/from\s+['"]\.\.\/contexts/g, "from '@/src/shared/contexts");
            content = content.replace(/from\s+['"]\.\.\/lib/g, "from '@/src/shared/lib");
            content = content.replace(/from\s+['"]\.\.\/db/g, "from '@/src/shared/db");
            content = content.replace(/from\s+['"]\.\.\/middleware/g, "from '@/src/shared/middleware");

            // For deeper files
            content = content.replace(/from\s+['"]\.\.\/\.\.\/components/g, "from '@/src/shared/components");
            content = content.replace(/from\s+['"]\.\.\/\.\.\/contexts/g, "from '@/src/shared/contexts");
            content = content.replace(/from\s+['"]\.\.\/\.\.\/lib/g, "from '@/src/shared/lib");
            content = content.replace(/from\s+['"]\.\.\/\.\.\/db/g, "from '@/src/shared/db");
            
            // Also fix Layout.tsx imports (which had ../../pages)
            // Wait, Layout.tsx is in shared/components now. No need for pages. 
            // It uses Link. No page imports!

            if (content !== original) {
                fs.writeFileSync(fullPath, content, 'utf8');
                console.log('Updated ' + fullPath);
            }
        }
    }
}

replaceInDir(path.join(__dirname, 'src'));
console.log('Done replacing src imports.');
