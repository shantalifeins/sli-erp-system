@layer base {
  body {
    @apply text-brand-charcoal bg-white font-sans;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-bold text-brand-charcoal;
  }

  /* Global table responsiveness for mobile */
  div:has(> table) {
    overflow: auto !important;
    min-height: 0 !important;
  }

  table {
    min-width: 800px;
  }
  
  @media (min-width: 768px) {
    table {
      min-width: 100%;
    }
  }

  table thead {
    position: sticky;
    top: 0;
    z-index: 10;
  }
}

/* Global mandatory field star indicator */
label:has(+ input:required)::after,
label:has(+ select:required)::after,
label:has(+ textarea:required)::after {
