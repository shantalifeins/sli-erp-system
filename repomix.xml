                {!isItemRequisition && (
                  <div>
                    <span className="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Procurement Method</span>
                    <span className="font-medium text-slate-700">{selectedPrDetails.procurementMethod || 'N/A'}</span>
