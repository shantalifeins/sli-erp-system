                  <div className="pt-2">
                    <div className="border border-slate-900 px-6 py-1.5 font-bold text-sm tracking-wider uppercase inline-block">
                      Work Order
                    </div>
                  </div>

                  {/* SHANTA Life Official Header Logo */}
                  <div className="text-right">
                    <img 
                      src="/assets/shanta_life_logo.png" 
