                      pr.status === 'PR Created' ? 'bg-purple-100 text-purple-700 border border-purple-200' :
                      pr.status === 'Rejected' ? 'bg-red-100 text-red-700 border border-red-200' :
                      'bg-blue-100 text-blue-700 border border-blue-200'
                    }`}>
